NODE_ENV=development
PORT=3000

# Optional exact frontend origins, comma-separated; use your actual local ports.
CORS_ORIGINS=http://localhost:3000
# HTTPS subdomains only; root domain requires a separate CORS_ORIGINS entry.
CORS_SUBDOMAIN_DOMAINS=workdesk24.com

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

DB_NAME=workdesk24

JWT_SECRET=your-secret

# JSON array of host IDs excluded from API log persistence; restart after changes.
API_LOG_SKIP_HOST_IDS=[]

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=