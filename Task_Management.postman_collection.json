            "body": { "mode": "raw", "raw": "{\n  \"taskId\": {{TASK_ID}},\n  \"remarks\": \"Completed the customer proposal\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{BASE_URL}}/api/v1/app/task/completeTask", "host": ["{{BASE_URL}}"], "path": ["api", "v1", "app", "task", "completeTask"] }
          },
          "response": []
