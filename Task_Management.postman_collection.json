            "body": { "mode": "raw", "raw": "{\n  \"taskId\": {{TASK_ID}},\n  \"page\": 1,\n  \"limit\": 20\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{BASE_URL}}/api/v1/app/task/getTaskActivity", "host": ["{{BASE_URL}}"], "path": ["api", "v1", "app", "task", "getTaskActivity"] }
          },
          "response": []
