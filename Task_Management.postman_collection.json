            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"taskId\": {{TASK_ID}},\n  \"comment\": \"I have started preparing the proposal.\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{BASE_URL}}/api/v1/app/task/addTaskComment", "host": ["{{BASE_URL}}"], "path": ["api", "v1", "app", "task", "addTaskComment"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const result = pm.response.json();", "if (result.success && result.data && result.data.comment && result.data.comment.id) pm.environment.set('COMMENT_ID', result.data.comment.id);"] } }],
          "response": []
        },
        {
          "name": "Get My Task Comments",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"taskId\": {{TASK_ID}},\n  \"page\": 1,\n  \"limit\": 20\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{BASE_URL}}/api/v1/app/task/getTaskComments", "host": ["{{BASE_URL}}"], "path": ["api", "v1", "app", "task", "getTaskComments"] }
          },
          "response": []
        },
        {
          "name": "Upload My Task Attachment",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [
              { "key": "taskId", "value": "{{TASK_ID}}", "type": "text" },
              { "key": "taskCommentId", "value": "{{COMMENT_ID}}", "type": "text", "disabled": true },
              { "key": "remarks", "value": "Supporting document", "type": "text", "disabled": true },
              { "key": "file", "type": "file", "src": [] }
            ] },
            "url": { "raw": "{{BASE_URL}}/api/v1/app/task/uploadTaskAttachment", "host": ["{{BASE_URL}}"], "path": ["api", "v1", "app", "task", "uploadTaskAttachment"] },
            "description": "Choose a JPEG, PNG, WEBP, or PDF file no larger than 10 MB. Postman sets the multipart Content-Type boundary automatically. The response data.attachment.fileName preserves normal filename characters and replaces path separators and control characters. Open data.attachment.fileUrl exactly as returned, including its authenticated Cloudinary signature and file extension. Cloudinary must allow PDF delivery in the account security settings."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const result = pm.response.json();", "if (result.success && result.data && result.data.attachment && result.data.attachment.id) pm.environment.set('ATTACHMENT_ID', result.data.attachment.id);"] } }],
          "response": []
        },
        {
          "name": "Get My Task Attachments",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"taskId\": {{TASK_ID}},\n  \"page\": 1,\n  \"limit\": 20\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{BASE_URL}}/api/v1/app/task/getTaskAttachments", "host": ["{{BASE_URL}}"], "path": ["api", "v1", "app", "task", "getTaskAttachments"] }
          },
          "response": []
        },
        {
          "name": "Get My Task Attachment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"taskId\": {{TASK_ID}},\n  \"attachmentId\": {{ATTACHMENT_ID}}\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{BASE_URL}}/api/v1/app/task/getTaskAttachment", "host": ["{{BASE_URL}}"], "path": ["api", "v1", "app", "task", "getTaskAttachment"] }
          },
          "response": []
        },
        {
          "name": "Download My Task Attachment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"attachmentId\": {{ATTACHMENT_ID}}\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{BASE_URL}}/api/v1/app/task/downloadAttachment", "host": ["{{BASE_URL}}"], "path": ["api", "v1", "app", "task", "downloadAttachment"] },
            "description": "Inherits the app Bearer TOKEN. Use Send and Download: HTTP 200 contains raw PDF/JPEG/PNG/WEBP bytes, not JSON. Requires a same-host, non-deleted task assigned to this user or same-host admin access; a linked comment must exist on that task. Errors use the standard JSON format: 400 invalid ID, 401 invalid authentication, 404 inaccessible/missing attachment/task/comment, 502 unavailable/untrusted upstream asset, 504 upstream timeout. No Cloudinary redirect or URL is returned by this endpoint."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Download succeeds', () => pm.response.to.have.status(200));",
            "pm.test('Response is an attachment, not a redirect', () => { pm.expect(pm.response.headers.get('Content-Disposition')).to.match(/^attachment;/); pm.expect(pm.response.headers.has('Location')).to.eql(false); });",
            "pm.test('Supported file content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/^(application\\/pdf|image\\/(jpeg|png|webp))$/));"
          ] } }],
          "response": []
        }
      ]
